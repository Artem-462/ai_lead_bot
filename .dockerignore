# Secrets — never bake into the image
.env
credentials.json

# Runtime data — managed by Docker volume
data/

# Virtual environments
venv/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Git
.git
.gitignore

# IDE & OS
.idea/
.vscode/
*.DS_Store

# Tests & linter caches
tests/
.pytest_cache/
.ruff_cache/

# Docs (not needed at runtime)
README.md
